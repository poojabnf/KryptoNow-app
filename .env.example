# ─── KryptoNow environment variables ────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local, .env, or .env.production to source control.
# For EAS builds, add secrets via: eas secret:create

# ── Clerk (authentication) ────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Alchemy (RPC / balance fetching) ─────────────────────────────────────────
# Get from https://dashboard.alchemy.com
EXPO_PUBLIC_ALCHEMY_KEY=your_alchemy_api_key

# ── Web vault encryption ──────────────────────────────────────────────────────
# 32+ character random string used to encrypt wallet data in browser storage.
# Generate: openssl rand -base64 32
EXPO_PUBLIC_VAULT_SECRET=your_random_32_char_secret

# ── Pimlico (ERC-4337 account abstraction) ────────────────────────────────────
# Get from https://dashboard.pimlico.io
EXPO_PUBLIC_PIMLICO_KEY=pim_your_pimlico_key

# ── 1inch Swap API ────────────────────────────────────────────────────────────
# Get from https://portal.1inch.dev
EXPO_PUBLIC_ONEINCH_KEY=your_1inch_api_key

# ── Fee collection wallet ─────────────────────────────────────────────────────
# Your Ethereum address that receives 0.1% swap fees via 1inch referral program
EXPO_PUBLIC_FEE_WALLET=0xYourFeeCollectionWalletAddress

# ── AI Assistant (Groq) ───────────────────────────────────────────────────────
# Get from https://console.groq.com
EXPO_PUBLIC_GROQ_API_KEY=gsk_your_groq_api_key

# ── WalletConnect ─────────────────────────────────────────────────────────────
# Get from https://cloud.walletconnect.com
EXPO_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# ── Backend API ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://api.kryptonow.xyz

# ── Admin ─────────────────────────────────────────────────────────────────────
# The wallet address that has access to the admin panel (/admin)
EXPO_PUBLIC_ADMIN_WALLET=0xYourAdminWalletAddress

# ─── Backend-only (kryptonow-backend/.env) ───────────────────────────────────
# These are NOT EXPO_PUBLIC — they stay on the server only.

# JWT signing secret — generate: openssl rand -hex 32
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars

# Admin wallet (same as above, server-side enforcement)
ADMIN_WALLET=0xYourAdminWalletAddress

# Database (Prisma)
DATABASE_URL=file:./dev.db
