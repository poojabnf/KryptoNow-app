{
    "expo":  {
                 "name":  "KryptoNow",
                 "slug":  "kryptonow",
                 "scheme":  "kryptonow",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "userInterfaceStyle":  "automatic",
                 "splash":  {
                                "image":  "./assets/splash.png",
                                "resizeMode":  "contain",
                                "backgroundColor":  "#1E1B4B"
                            },
                 "ios":  {
                             "supportsTablet":  false,
                             "bundleIdentifier":  "com.kryptonow.app",
                             "infoPlist":  {
                                               "NSCameraUsageDescription":  "KryptoNow uses your camera to scan WalletConnect QR codes.",
                                               "NSFaceIDUsageDescription":  "KryptoNow uses Face ID to protect your wallet.",
                                               "CFBundleURLTypes":  [
                                                                        {
                                                                            "CFBundleURLSchemes":  [
                                                                                                       "kryptonow"
                                                                                                   ]
                                                                        },
                                                                        {
                                                                            "CFBundleURLSchemes":  [
                                                                                                       "kryptonow"
                                                                                                   ]
                                                                        }
                                                                    ]
                                           },
                             "googleServicesFile":  "./GoogleService-Info.plist"
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/adaptive-icon.png",
                                                      "backgroundColor":  "#1E1B4B"
                                                  },
                                 "edgeToEdgeEnabled":  true,
                                 "predictiveBackGestureEnabled":  false,
                                 "package":  "com.kryptonow.app",
                                 "permissions":  [
                                                     "android.permission.CAMERA",
                                                     "android.permission.USE_BIOMETRIC",
                                                     "android.permission.USE_FINGERPRINT",
                                                     "android.permission.INTERNET",
                                                     "android.permission.VIBRATE",
                                                     "android.permission.RECEIVE_BOOT_COMPLETED",
                                                     "android.permission.RECORD_AUDIO",
                                                     "android.permission.CAMERA",
                                                     "android.permission.USE_BIOMETRIC",
                                                     "android.permission.USE_FINGERPRINT",
                                                     "android.permission.INTERNET",
                                                     "android.permission.VIBRATE",
                                                     "android.permission.RECEIVE_BOOT_COMPLETED",
                                                     "android.permission.RECORD_AUDIO"
                                                 ],
                                 "intentFilters":  [
                                                       {
                                                           "action":  "VIEW",
                                                           "autoVerify":  true,
                                                           "data":  [
                                                                        {
                                                                            "scheme":  "kryptonow"
                                                                        }
                                                                    ],
                                                           "category":  [
                                                                            "BROWSABLE",
                                                                            "DEFAULT"
                                                                        ]
                                                       }
                                                   ],
                                 "googleServicesFile":  "./google-services.json"
                             },
                 "web":  {
                             "favicon":  "./assets/favicon.png",
                             "bundler":  "metro",
                             "htmlTemplate":  "./web/index.html"
                         },
                 "extra":  {
                               "eas":  {
                                           "projectId":  "3e0e9648-5e02-41b6-b5ba-fa1aff3ce88b"
                                       },
                               "website":  "https://kryptonow.xyz"
                           },
                 "owner":  "kryptonow-inc",
                 "plugins":  [
                                 "expo-web-browser",
                                 "expo-router",
                                 "expo-secure-store",
                                 [
                                     "expo-camera",
                                     {
                                         "cameraPermission":  "Allow KryptoNow to access your camera to scan QR codes."
                                     }
                                 ],
                                 [
                                     "expo-notifications",
                                     {
                                         "icon":  "./assets/notification-icon.png",
                                         "color":  "#6366F1",
                                         "defaultChannel":  "default"
                                     }
                                 ],
                                 "@react-native-firebase/app",
                                 "@react-native-firebase/messaging",
                                 "expo-local-authentication"
                             ],
                 "runtimeVersion":  {
                                        "policy":  "appVersion"
                                    },
                 "updates":  {
                                 "url":  "https://u.expo.dev/3e0e9648-5e02-41b6-b5ba-fa1aff3ce88b"
                             }
             }
}
