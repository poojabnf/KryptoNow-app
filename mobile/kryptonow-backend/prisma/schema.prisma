generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(uuid())
  publicAddress String   @unique
  nonce         String   
  username      String?
  fcmToken      String?   // Firebase Cloud Messaging token  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

