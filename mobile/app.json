{
  "expo": {
    "name": "KryptoNow",
    "slug": "kryptonow",
    "scheme": "kryptonow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kryptonow.app",
      "buildNumber": "1",
      "minimumOsVersion": "16.0",
      "infoPlist": {
        "NSCameraUsageDescription": "KryptoNow uses your camera to scan WalletConnect QR codes.",
        "NSFaceIDUsageDescription": "KryptoNow uses Face ID to protect your wallet.",
        "NSPhotoLibraryUsageDescription": "KryptoNow needs photo library access to import QR code images.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          { "CFBundleURLSchemes": ["kryptonow"] }
        ]
      },
      "associatedDomains": ["applinks:kryptonow.xyz"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1B4B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kryptonow.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "kryptonow" },
            { "scheme": "https", "host": "kryptonow.xyz" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "htmlTemplate": "./web/index.html"
    },
    "extra": {
      "eas": { "projectId": "9698df38-e5fe-4d59-826f-19d44cc45c14" },
      "website": "https://kryptonow.xyz"
    },
    "owner": "poojabnf",
    "plugins": [
      "expo-web-browser",
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      ["expo-camera", { "cameraPermission": "Allow KryptoNow to access your camera to scan QR codes." }],
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#6366F1", "defaultChannel": "default" }],
      ["expo-local-authentication", { "faceIDPermission": "KryptoNow uses Face ID to protect your wallet." }],
      ["expo-build-properties", {
        "ios": { "deploymentTarget": "16.0" },
        "android": { "minSdkVersion": 26, "targetSdkVersion": 35, "compileSdkVersion": 35 }
      }],
      "expo-font"
    ],
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "url": "https://u.expo.dev/9698df38-e5fe-4d59-826f-19d44cc45c14" }
  }
}
