# kryptonow-backend/.env — copy to .env and fill in values
# NEVER commit .env to source control

# JWT signing secret (required — server refuses to start without it)
# Generate: openssl rand -hex 32
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars

# Admin wallet address — only this wallet can access /admin/* routes
ADMIN_WALLET=0xYourAdminWalletAddress

# Database connection (Prisma)
DATABASE_URL=file:./dev.db
